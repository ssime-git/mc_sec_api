# OAuth2 Demo Configuration
# =========================
# Copy this file to .env and configure for your setup

# HOST_IP: The IP address where your services will be accessible
# Examples:
#   - For local development: HOST_IP=localhost
#   - For public server: HOST_IP=your.server.ip.address  
#   - For Tailscale/VPN: HOST_IP=your.tailscale.ip
#   - For Docker/WSL: HOST_IP=your.docker.ip
# Leave blank for auto-detection: HOST_IP=
HOST_IP=

# Optional: Override individual service ports if needed
# AUTH_PORT=5050
# RESOURCE_PORT=5051
# CLIENT_PORT=5052
